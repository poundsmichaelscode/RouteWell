{
  "name": "@routewell/backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prisma:generate": "npm run prisma:sync && prisma generate --config prisma.config.ts",
    "prisma:migrate:dev": "npm run prisma:sync && prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "npm run prisma:sync && prisma migrate deploy --config prisma.config.ts",
    "prisma:migrate:status": "npm run prisma:sync && prisma migrate status --config prisma.config.ts",
    "prisma:seed": "tsx src/scripts/seed.ts",
    "swagger:check": "tsx src/scripts/validate-openapi.ts",
    "prisma:seed:prod": "node dist/scripts/seed.js",
    "prisma:sync": "rm -rf prisma && cp -R ../database/prisma ./prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "express-rate-limit": "^8.2.2",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "jsonwebtoken": "9.0.2",
    "prisma": "6.19.3",
    "prom-client": "15.1.3",
    "swagger-ui-express": "5.0.1",
    "uuid": "11.1.0",
    "winston": "3.17.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.1.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.32.0",
    "supertest": "7.1.4",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "ip-address": "10.3.1"
  }
}
